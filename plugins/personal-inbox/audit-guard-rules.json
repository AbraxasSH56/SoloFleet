{
  "版本": 1,
  "说明": "Audit guard rules. Applies only to the system-auditor and task-auditor roles; any option not listed is refused. p4ApprovalTest stays false except while testing the approval-forwarding path. Fixed snippets are matched on a normalized text: whole lines starting with # , blank lines and trailing whitespace are ignored, code lines must match character for character (indentation included, no quote substitution). This assumes a snippet has no block that uses # lines or blank lines as data (heredoc data blocks, triple-quoted strings, multi-line double-quoted strings); run the precondition scan in tests/audit-guard.test.mjs before changing a snippet. Trigger-script exception: exec calls sent by the trigger scripts of the daily audit and the deep review skip the per-item command-text check only when ALL of these hold: role is system-auditor; session key is exactly agent:system-auditor:cron:<job id>:trigger; run id starts with cron-trigger:<same job id>:; the job id is listed in triggerJobs below. Everything else (exec extra parameters, always-refused tools, write/edit rules) stays in force, and every pass-through is logged with the job id, the first 200 characters and the sha256 of the whole command. paths.dataRoot / paths.projectRoot here are defaults; config/crew.json (paths.dataRoot, paths.projectRoot) overrides them. Snippet 'file' is relative to projectRoot and may be an object keyed by locale; 'start'/'end' likewise. The system-auditor git rule needs 'git -C <dataRoot or projectRoot> [--no-pager] log ...' (requireC); only log is allowed (show can print whole files); no -p/-S/-G/--grep/--graph/-s; at most one commit argument without a colon; at most 5 paths after --. jq is checked with a forbidden-words filter (env, ENV, input, inputs, debug, stderr, halt, import, include ...): it only over-blocks, it is not a proof that a filter is safe. sed accepts Nd, N,Md, N,$d and -n with /regex/p.",
  "p4ApprovalTest": false,
  "triggerJobs": {
    "00000000-0000-4000-8000-000000000001": "daily-audit",
    "00000000-0000-4000-8000-000000000002": "deep-review"
  },
  "p4Test": {
    "agentId": "worker-e",
    "channelId": "100000000000000100",
    "command": "echo P4转发测试"
  },
  "paths": {
    "dataRoot": "/opt/solofleet-data",
    "projectRoot": "/opt/solofleet"
  },
  "writeDirs": [
    "审计/日审",
    "审计/额度读数",
    "审计/异常深审",
    "审计/周审",
    "审计/异常标记"
  ],
  "denyWriteDirs": [
    "审计/发布/凭据"
  ],
  "editExtra": [
    "项目/*/PROJECT.md",
    "项目/*/任务/*.md"
  ],
  "localeOverrides": {
    "note": "Rules above are the zh-CN ones. With locale en the audit guard reads the same four settings from here instead (it never edits this object; see effectiveRules in audit-guard.mjs).",
    "en": {
      "writeDirs": [
        "audit/daily",
        "audit/quota-readings",
        "audit/deep-review",
        "audit/weekly",
        "audit/anomaly-flags"
      ],
      "denyWriteDirs": [
        "audit/publish/receipts"
      ],
      "editExtra": [
        "projects/*/PROJECT.md",
        "projects/*/tasks/*.md"
      ],
      "publishTasks": [
        "deep-review",
        "weekly-audit"
      ]
    }
  },
  "snippets": [
    {
      "name": "业务日期片段",
      "file": {
        "zh-CN": "jobs/daily-audit.zh-CN.md",
        "en": "jobs/daily-audit.md"
      },
      "start": {
        "zh-CN": "# 业务日期片段开始",
        "en": "# business-date-snippet begin"
      },
      "end": {
        "zh-CN": "# 业务日期片段结束",
        "en": "# business-date-snippet end"
      },
      "vars": {
        "HM": {
          "re": "^[0-2][0-9]:[0-5][0-9]$",
          "required": true
        },
        "DOW": {
          "re": "^[0-6]?$",
          "required": false
        }
      }
    },
    {
      "name": "范围外文件查法",
      "file": {
        "zh-CN": "jobs/daily-audit.zh-CN.md",
        "en": "jobs/daily-audit.md"
      },
      "start": {
        "zh-CN": "# 范围外文件查法开始",
        "en": "# out-of-scope-file-check begin"
      },
      "end": {
        "zh-CN": "# 范围外文件查法结束",
        "en": "# out-of-scope-file-check end"
      },
      "vars": {
        "A": {
          "re": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "required": true
        },
        "B": {
          "re": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "required": true
        },
        "DR": {
          "enum": [
            "${dataRoot}"
          ],
          "required": true
        },
        "PR": {
          "enum": [
            "${projectRoot}"
          ],
          "required": true
        }
      }
    },
    {
      "name": "周审程序核对",
      "file": {
        "zh-CN": "jobs/weekly-audit.zh-CN.md",
        "en": "jobs/weekly-audit.md"
      },
      "start": {
        "zh-CN": "# 周审程序核对开始",
        "en": "# weekly-program-check begin"
      },
      "end": {
        "zh-CN": "# 周审程序核对结束",
        "en": "# weekly-program-check end"
      },
      "vars": {}
    }
  ],
